{
  "name": "app-dragonettecrochet",
  "version": "0.61.0",
  "private": true,
  "type": "module",
  "description": "Stitch-chart editor for the Dragonette Crochet patterns — vanilla TypeScript and canvas.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.core.json",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "kiadas": "bash scripts/kiadas.sh",
    "visszaallitas": "bash scripts/visszaallitas.sh",
    "fust": "playwright test --config playwright.prod.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
