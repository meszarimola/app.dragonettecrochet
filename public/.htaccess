# Mintatervező — Apache konfiguráció (Rackforest webtárhely).
#
# Ez a fájl a public/-ból a build gyökerébe kerül, tehát a dist/ feltöltésével
# automatikusan a helyére kerül. A fő oldal .htaccess-ét követi, a tervezőre
# szabott eltérésekkel.

# ---------------------------------------------------------------- HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://app.dragonettecrochet.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------- Fejlécek
<IfModule mod_headers.c>
  # A blob: azért kerül be, mert egy későbbi kép-export `URL.createObjectURL`-lel
  # készül majd.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # A tervező ne kerüljön a találatok közé, de a linkjei (a főoldal felé)
  # követhetők maradjanak: noindex, nofollow nélkül (PQW-853). A HTML-ben is
  # ott a meta robots; a fejléc a nem-HTML válaszokat is lefedi. A robots.txt-be
  # nem kerül Disallow, különben a kereső nem látná a noindexet.
  Header always set X-Robots-Tag "noindex"
</IfModule>

# ---------------------------------------------------------------- Cache
#
# Mint a fő oldalon: a cache-t a mod_headers állítja, mert ezen a LiteSpeeden
# a mod_expires nincs bekapcsolva.
<IfModule mod_headers.c>
  # A Vite tartalom-hasht tesz a nevekbe, tehát ezek örökre cache-elhetők.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff2|png|jpg|jpeg|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------- Tömörítés
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# ---------------------------------------------------------------- Egyéb
Options -Indexes

<FilesMatch "\.(md|mjs|ts)$">
  Require all denied
</FilesMatch>
